

<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <% if (requests.length === 0) { %>
  <p>No rental requests found.</p>
  <% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% requests.forEach(request => { %> <% if (!request.listing_id) { %> <%
    console.log("⚠️ Warning: Missing listing_id in request:", request); %> <% }
    %>
    <div class="col mb-4">
      <div class="card">
        <!-- Card Body -->
        <div class="card-body">
          <!-- Image and Title Section -->
          <div class="d-flex align-items-center mb-3 justify-content-center">
            <div>
              <div
                style="
                  max-width: 100%;
                  margin: 0 auto;
                  border-radius: 15px;
                  overflow: hidden;
                "
              >
                <img
                  src="<%=  request.listing_id.image.url 
                           ? request.listing_id.image.url 
                           : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8N3x8aG90ZWxzfGVufDB8fDB8fHww&auto=format&fit=crop&w=800&q=60' %>"
                  alt="Image"
                  style="
                    width: 100%;
                    height: 50%;
                    border-radius: 15px;
                    display: block;
                  "
                />
              </div>

              <h5 class="card-title mb-0"><%= request.listing_id.title %></h5>
              <p class="card-text">
                <strong>Price:</strong> $<%= request.listing_id.price %>
              </p>
            </div>
          </div>

          <!-- Status and Rental Period Section -->
          <p class="card-text"><strong>Status:</strong>Approved</p>
          <p class="card-text">
            <strong>Rental Period:</strong>
            <%= new Date(request.rental_start_date).toLocaleDateString() %> -
            <%= new Date(request.rental_end_date).toLocaleDateString() %>
          </p>
        </div>
        <!-- Card Footer (Buttons) -->
        <div class="card-footer d-flex justify-content-between">
          <!-- Proceed to Rent Button -->
          <form
            action="/rent/checkout/<%= request.user_id %>/<%= request.listing_id._id %>"
            method="GET"
          >
            <button type="submit" class="btn btn-primary">
              Proceed to Rent
            </button>
          </form>

          <!-- Delete Button -->
          <form
            action="/rent/delete/<%= request._id %>/<%= request.user_id %>"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this item?');"
          >
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
